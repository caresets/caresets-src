@startuml
left to right direction
skinparam shadowing false
skinparam nodesep 10
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam class {
  FontStyle italic
  BackgroundColor<<rootconcept>> #FAC08F
  BorderColor<<rootconcept>> #E36C0A
  BackgroundColor<<data>> #B8CCE4
  BorderColor<<data>> #4F81BD
  BackgroundColor<<reference>> #D9D9D9
  BorderColor<<reference>> #808080
  BackgroundColor<<value set>> #C3D69B
  BorderColor<<value set>> #77933C
  ArrowColor #4F81BD
}
hide circle
hide empty members

class "BeModelPatientDocument" as BeModelPatientDocument <<rootconcept>> {
}

class "patient" as BeModelPatientDocument_patient <<data>> {
}

class "author" as BeModelPatientDocument_author <<data>> {
}

class "category" as BeModelPatientDocument_category <<data>> {
}

class "document" as BeModelPatientDocument_document <<rootconcept>> {
}

class "content" as BeModelPatientDocument_document_content <<data>> {
}

class "mimetype" as BeModelPatientDocument_document_mimetype <<data>> {
}

class "url" as BeModelPatientDocument_document_url <<data>> {
}

class "context" as BeModelPatientDocument_context <<data>> {
}

BeModelPatientDocument_patient "1..1" --> BeModelPatientDocument
BeModelPatientDocument_author "1..1" --> BeModelPatientDocument
BeModelPatientDocument_category "0..*" --> BeModelPatientDocument
BeModelPatientDocument_document "1..1" --> BeModelPatientDocument
BeModelPatientDocument_document_content "0..1" --> BeModelPatientDocument_document
BeModelPatientDocument_document_mimetype "1..1" --> BeModelPatientDocument_document
BeModelPatientDocument_document_url "0..1" --> BeModelPatientDocument_document
BeModelPatientDocument_context "0..*" --> BeModelPatientDocument
@enduml
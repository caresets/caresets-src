          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_expectedNumberOfChildren_attr_doc" body="The number of births the practitioner expects in the delivery, usually estimated from the ultrasound."/>

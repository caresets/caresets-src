        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_pregnancyStartDate_attr" name="pregnancyStartDate" visibility="public" type="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_pregnancyStartDate" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_pregnancyStartDate_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_pregnancyStartDate_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_pregnancyStartDate_attr_doc" body="The date the pregnancy began, usually estimated as the first day of the last menstrual period (LMP) or from an early ultrasound."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_estimatedDateOfDelivery_attr" name="estimatedDateOfDelivery" visibility="public" type="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_estimatedDateOfDelivery" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_estimatedDateOfDelivery_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_estimatedDateOfDelivery_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_estimatedDateOfDelivery_attr_doc" body="The date the practitioner expects the delivery, usually etimated from the ultrasound. It normally does not change after the initial etimation; the actual delivery date is typically within ±2 weeks."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_dateOfEndOfPregnancy_attr" name="dateOfEndOfPregnancy" visibility="public" type="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_dateOfEndOfPregnancy" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_dateOfEndOfPregnancy_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_dateOfEndOfPregnancy_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_dateOfEndOfPregnancy_attr_doc" body="The actual end date of the pregnancy."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_expectedNumberOfChildren_attr" name="expectedNumberOfChildren" visibility="public" type="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_expectedNumberOfChildren" aggregation="composite">

  <uml:Model xmi:type="uml:Model" xmi:id="id_PregnancyStatusDataSet_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_PregnancyStatusDataSet_pkg" name="PregnancyStatusDataSet" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_PregnancyStatusDataSet" name="PregnancyStatusDataSet" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_doc" body="Logical model for the pregnancy-status data.

This is the minimal data set for the pregnancy status (consumed, for example, via
Vitalink FHIR / MAGDA / VUTG / mijnburgerprofiel.be / mijngezondheid.be /
caregivers)."/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_attr" name="pregnancy" visibility="public" type="id_PregnancyStatusDataSet_pregnancy" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_PregnancyStatusDataSet_pregnancy_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PregnancyStatusDataSet_pregnancy_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_attr_doc" body="Pregnancy Episode"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="id_PregnancyStatusDataSet_pregnancy" name="pregnancy" visibility="public">
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_patient_attr" name="patient" visibility="public" type="id_type_Reference_Patient_">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_PregnancyStatusDataSet_pregnancy_patient_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PregnancyStatusDataSet_pregnancy_patient_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_patient_attr_doc" body="The patient who is pregnant. The reference may identify the patient by pseudonymised SSIN, depending on the implementation."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_author_attr" name="author" visibility="public" type="id_type_Reference_Practitioner_">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_PregnancyStatusDataSet_pregnancy_author_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PregnancyStatusDataSet_pregnancy_author_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_author_attr_doc" body="The healthcare professional who takes responsibility for the recording of the pregnancy information"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_updateDate_attr" name="updateDate" visibility="public" type="id_type_date">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_PregnancyStatusDataSet_pregnancy_updateDate_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PregnancyStatusDataSet_pregnancy_updateDate_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_updateDate_attr_doc" body="The last date on which the pregnant woman was observed by her gynaecologist or midwife during the pregnancy."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_firstRecordedDate_attr" name="firstRecordedDate" visibility="public" type="id_type_date">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_PregnancyStatusDataSet_pregnancy_firstRecordedDate_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PregnancyStatusDataSet_pregnancy_firstRecordedDate_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_firstRecordedDate_attr_doc" body="The date the pregnancy was first registered in the system. This is not the date the pregnancy was observed, but the date it was entered in the system for the first time."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_attr" name="pregnancyStatus" visibility="public" type="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus_attr_doc" body="Observation conveying the current pregnancy status of the woman at the date of observation (e.g. pregnant, not pregnant). Bound to SNOMED CT, EHDS Patient Summary aligned."/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="id_PregnancyStatusDataSet_pregnancy_pregnancyStatus" name="pregnancyStatus" visibility="public">

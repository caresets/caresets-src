  <xmi:Documentation exporter="generate_model_diagrams" exporterVersion="1.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="id_BeModelProblem_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_BeModelProblem_pkg" name="BeModelProblem" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelProblem" name="BeModelProblem" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_doc" body="Logical model for Problem"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_identifier_attr" name="identifier" visibility="public" type="id_type_Identifier">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelProblem_identifier_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_identifier_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_identifier_attr_doc" body="Unique identifier of the problem"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_recordedDate_attr" name="recordedDate" visibility="public" type="id_type_dateTime">

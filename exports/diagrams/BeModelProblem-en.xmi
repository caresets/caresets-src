          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_clinicalStatus_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_clinicalStatus_attr_doc" body="Clinical status of the problem (active, inactive, resolved, etc.) [ValueSet: condition-clinical]"/>

        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_verificationStatus_attr" name="verificationStatus" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelProblem_verificationStatus_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_verificationStatus_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_verificationStatus_attr_doc" body="Degree of certainty associated with the problem (confirmed, suspected, etc.) [ValueSet: condition-ver-status]"/>

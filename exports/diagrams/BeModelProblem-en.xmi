        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_recorder_attr" name="recorder" visibility="public" type="id_type_Identifier">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelProblem_recorder_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_recorder_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_recorder_attr_doc" body="The healthcare professional responsible for the content (ideally identified by the NISS)"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_asserter_attr" name="asserter" visibility="public" type="id_type_Identifier">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelProblem_asserter_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_asserter_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_asserter_attr_doc" body="The person asserting the information (e.g., patient, practitioner, parent; ideally identified by the NISS)"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_subject_attr" name="subject" visibility="public" type="id_type_Reference_Patient_">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelProblem_subject_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_subject_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_subject_attr_doc" body="Reference or Identifier to the patient (ideally identified by the NISS)"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_cause_attr" name="cause" visibility="public" type="id_type_Reference_Condition___Procedure___MedicationAdministration___Immunization___MedicationStatement_">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelProblem_cause_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_cause_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_cause_attr_doc" body="Reference to the primary cause of the problem (procedure, medication administration, or other condition)"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_category_attr" name="category" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelProblem_category_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_category_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_category_attr_doc" body="Thematic category of the problem [ValueSet: ProblemCategoryVS]"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_code_attr" name="code" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelProblem_code_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_code_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_code_attr_doc" body="Identification of the problem - in SNOMED-CT [ValueSet: ProblemCodeVS]"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_clinicalStatus_attr" name="clinicalStatus" visibility="public" type="id_type_CodeableConcept">

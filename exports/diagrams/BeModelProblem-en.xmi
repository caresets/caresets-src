          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_abatement_x__attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_abatement_x__attr_doc" body="Moment the problem went into remission"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_note_attr" name="note" visibility="public" type="id_type_Annotation">

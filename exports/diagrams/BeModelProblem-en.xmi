        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelProblem_onset_x__attr" name="onset[x]" visibility="public" type="id_type_dateTime___Period___Range___Age___string">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelProblem_onset_x__attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_onset_x__attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_onset_x__attr_doc" body="Moment the problem began"/>

          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelProblem_recordedDate_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelProblem_recordedDate_attr_doc" body="Date of last modification of the information by the recorder"/>

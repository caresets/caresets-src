          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccination_administeredProduct_expirationDate_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccination_administeredProduct_expirationDate_attr_doc" body="The expiration date of the product."/>
        </ownedAttribute>
      </packagedElement>

        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccination_administeredProduct_lotNumber_attr" name="lotNumber" visibility="public" type="id_type_string">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelVaccination_administeredProduct_lotNumber_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccination_administeredProduct_lotNumber_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccination_administeredProduct_lotNumber_attr_doc" body="The lot number"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccination_administeredProduct_expirationDate_attr" name="expirationDate" visibility="public" type="id_type_date">

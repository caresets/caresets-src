          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PSSConsentModel_hcpID_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PSSConsentModel_hcpID_attr_doc" body="The anonymised ID of the healthcare professional"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PSSConsentModel_recordedDate_attr" name="recordedDate" visibility="public" type="id_type_date">

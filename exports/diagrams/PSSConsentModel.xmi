          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_PSSConsentModel_recordedDate_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_PSSConsentModel_recordedDate_attr_doc" body="Date on which the information was recorded"/>

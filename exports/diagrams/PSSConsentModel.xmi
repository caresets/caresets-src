          <ownedComment xmi:type="uml:Comment" xmi:id="id_PSSConsentModel_consent_attr_doc" body="accepted, rejected"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PSSConsentModel_provision_attr" name="provision" visibility="public" type="id_PSSConsentModel_provision" aggregation="composite">

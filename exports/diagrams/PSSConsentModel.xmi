          <ownedComment xmi:type="uml:Comment" xmi:id="id_PSSConsentModel_instruction_attr_doc" body="The instruction to the HCP"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PSSConsentModel_termsConditions_attr" name="termsConditions" visibility="public" type="id_PSSConsentModel_termsConditions" aggregation="composite">

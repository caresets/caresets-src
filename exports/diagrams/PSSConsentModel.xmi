  <uml:Model xmi:type="uml:Model" xmi:id="id_PSSConsentModel_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_PSSConsentModel_pkg" name="PSSConsentModel" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_PSSConsentModel" name="PSSConsentModel" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_PSSConsentModel_doc" body="Consent statement about using PSS and agreeing with (or opting out of) the Terms and Conditions."/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_PSSConsentModel_hcpID_attr" name="hcpID" visibility="public" type="id_type_string">

@startuml
left to right direction
skinparam shadowing false
skinparam nodesep 10
skinparam ranksep 40
skinparam classAttributeIconSize 0
skinparam class {
  FontStyle italic
  BackgroundColor<<rootconcept>> #FAC08F
  BorderColor<<rootconcept>> #E36C0A
  BackgroundColor<<data>> #B8CCE4
  BorderColor<<data>> #4F81BD
  BackgroundColor<<reference>> #D9D9D9
  BorderColor<<reference>> #808080
  BackgroundColor<<value set>> #C3D69B
  BorderColor<<value set>> #77933C
  ArrowColor #4F81BD
}
hide circle
hide empty members

class "BeModelPopulationScreeningPlan" as BeModelPopulationScreeningPlan <<rootconcept>> {
}

class "patient" as BeModelPopulationScreeningPlan_patient <<reference>> {
}

class "screeningType" as BeModelPopulationScreeningPlan_screeningType <<data>> {
}

class "screeningEpisode" as BeModelPopulationScreeningPlan_screeningEpisode <<data>> {
}

BeModelPopulationScreeningPlan_patient "1..1" --> BeModelPopulationScreeningPlan
BeModelPopulationScreeningPlan_screeningType "1..1" --> BeModelPopulationScreeningPlan
BeModelPopulationScreeningPlan_screeningEpisode "0..*" --> BeModelPopulationScreeningPlan
@enduml
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelOrganisationClaim_status_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelOrganisationClaim_status_attr_doc" body="Status of the task"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelOrganisationClaim_treatmentStatusId_attr" name="treatmentStatusId" visibility="public" type="id_type_Reference_BeModelTreatmentStatus_">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelOrganisationClaim_treatmentStatusId_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelOrganisationClaim_treatmentStatusId_attr_up" value="1"/>

          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelOrganisationClaim_intent_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelOrganisationClaim_intent_attr_doc" body="Defaults to &#x27;Order&#x27;"/>

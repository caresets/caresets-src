          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelOrganisationClaim_identifier_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelOrganisationClaim_identifier_attr_doc" body="Business Identifier. Absent during creation by client software, otherwise always present."/>

  <uml:Model xmi:type="uml:Model" xmi:id="id_BeModelOrganisationClaim_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_BeModelOrganisationClaim_pkg" name="BeModelOrganisationClaim" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelOrganisationClaim" name="BeModelOrganisationClaim" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelOrganisationClaim_doc" body="Information of a claim of an organisation to have the prescription fulfilled."/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelOrganisationClaim_identifier_attr" name="identifier" visibility="public" type="id_type_Identifier">

  <uml:Model xmi:type="uml:Model" xmi:id="id_BeModelVaccinationReduced_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_BeModelVaccinationReduced_pkg" name="BeModelVaccinationReduced" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelVaccinationReduced" name="BeModelVaccinationReduced" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccinationReduced_doc" body="Reduced Logical Model for vaccination"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_patient_attr" name="patient" visibility="public" type="id_type_Reference_Patient_">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelVaccinationReduced_patient_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccinationReduced_patient_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccinationReduced_patient_attr_doc" body="The patient that has received the vaccination."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_performer_attr" name="performer" visibility="public" type="id_type_Reference_Practitioner_">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelVaccinationReduced_performer_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccinationReduced_performer_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccinationReduced_performer_attr_doc" body="The professional that administered the medication. Use code &quot;unknown&quot; if not known."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_administeredProduct_attr" name="administeredProduct" visibility="public" type="id_BeModelVaccinationReduced_administeredProduct" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelVaccinationReduced_administeredProduct_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccinationReduced_administeredProduct_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccinationReduced_administeredProduct_attr_doc" body="The details of the product that was administered"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_identifier_attr" name="identifier" visibility="public" type="id_type_Identifier">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelVaccinationReduced_identifier_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccinationReduced_identifier_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccinationReduced_identifier_attr_doc" body="The business identifier(s) for the vaccination entry - This is an optional attribute, used for example to track an entry throughout its lifecycle, or across vaults."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_vaccinationDate_x__attr" name="vaccinationDate[x]" visibility="public" type="id_type_dateTime___string">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelVaccinationReduced_vaccinationDate_x__attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccinationReduced_vaccinationDate_x__attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccinationReduced_vaccinationDate_x__attr_doc" body="The date and/or time when the vaccine administration has been administered or presumed to be administered"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_recorded_attr" name="recorded" visibility="public" type="id_type_dateTime">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelVaccinationReduced_recorded_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccinationReduced_recorded_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccinationReduced_recorded_attr_doc" body="The date and time when the administration of the vaccine was recorded - typically used when the vaccine event is recorded a posteriori."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_doseQuantity_attr" name="doseQuantity" visibility="public" type="id_type_BackboneElement">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelVaccinationReduced_doseQuantity_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccinationReduced_doseQuantity_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccinationReduced_doseQuantity_attr_doc" body="The number or quantity of product(s) that was administered - e.g. 1/2 dose, etc."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_targetDisease_attr" name="targetDisease" visibility="public" type="id_type_CodeableConcept">

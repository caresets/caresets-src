        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_sideEffects_attr" name="sideEffects" visibility="public" type="id_type_Attachment">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelVaccinationReduced_sideEffects_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelVaccinationReduced_sideEffects_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelVaccinationReduced_sideEffects_attr_doc" body="Any noted side effect from this vaccination."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelVaccinationReduced_cause_attr" name="cause" visibility="public" type="id_type_CodeableConcept">

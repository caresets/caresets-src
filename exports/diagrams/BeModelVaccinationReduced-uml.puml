@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FEFECE
  BorderColor #000000
  ArrowColor #000000
  FontStyle bold
  AttributeFontStyle normal
}
hide circle
hide empty members

class "BeModelVaccinationReduced" as BeModelVaccinationReduced {
  +patient : Reference(Patient) [1]
  +performer : Reference(Practitioner) [1]
  +identifier : Identifier [0..1]
  +vaccinationDate[x] : dateTime | string [0..1]
  +recorded : dateTime [1]
  +doseQuantity : BackboneElement [0..1]
  +targetDisease : CodeableConcept [1]
  +sideEffects : Attachment [0..1]
  +cause : CodeableConcept [0..1]
}

class "BeModelVaccinationReduced.administeredProduct" as BeModelVaccinationReduced_administeredProduct {
  +product : Coding [1]
  +description : string [1]
  +lotNumber : string [0..1]
}

BeModelVaccinationReduced *-- "1..1" BeModelVaccinationReduced_administeredProduct : administeredProduct
@enduml
      <elements>
        <element subject="id_BeModelMedication" geometry="Left=40;Top=40;Right=300;Bottom=240;"/>
        <element subject="id_BeModelMedication_item" geometry="Left=340;Top=40;Right=600;Bottom=240;"/>
        <element subject="id_BeModelMedication_item_ingredient" geometry="Left=640;Top=40;Right=900;Bottom=240;"/>

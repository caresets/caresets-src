<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1">
  <xmi:Documentation exporter="generate_model_diagrams" exporterVersion="1.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="id_BeModelMedication_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_BeModelMedication_pkg" name="BeModelMedication" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelMedication" name="BeModelMedication" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_doc" body="Logical data model for medication."/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_status_attr" name="status" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_status_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_status_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_status_attr_doc" body="Status of the medication (active, inactive, etc.)"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_code_attr" name="code" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_code_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_code_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_code_attr_doc" body="Code for the medication that is actually being specified. This can be a product code, a virtual product code, or a package code."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_doseForm_attr" name="doseForm" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_doseForm_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_doseForm_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_doseForm_attr_doc" body="Dose form(s) on a product level. Dose form for a single package item is defined below."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_item_attr" name="item" visibility="public" type="id_BeModelMedication_item" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_item_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_item_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_item_attr_doc" body="A medication item. For combination packs, this can be manufactured items with each item having its own dose form and ingredients+strengths defined"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_batch_attr" name="batch" visibility="public" type="id_BeModelMedication_batch" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_batch_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_batch_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_batch_attr_doc" body="Batch or production information for the product"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelMedication_item" name="item" visibility="public">
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_item_ingredient_attr" name="ingredient" visibility="public" type="id_BeModelMedication_item_ingredient" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_item_ingredient_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_item_ingredient_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_item_ingredient_attr_doc" body="Ingredients"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_item_amount_attr" name="amount" visibility="public" type="id_type_Quantity">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_item_amount_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_item_amount_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_item_amount_attr_doc" body="Number of such manufactured items in this product (5 vials)"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelMedication_item_ingredient" name="ingredient" visibility="public">
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_item_ingredient_item_attr" name="item" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_item_ingredient_item_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_item_ingredient_item_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_item_ingredient_item_attr_doc" body="Substance or product that is ingredient"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_item_ingredient_role_attr" name="role" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_item_ingredient_role_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_item_ingredient_role_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_item_ingredient_role_attr_doc" body="Role (active ingredient, excipient). Typically excipients are not needed, so by default active ingredients are expected."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_item_ingredient_strength_attr" name="strength" visibility="public" type="id_type_Ratio">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_item_ingredient_strength_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_item_ingredient_strength_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_item_ingredient_strength_attr_doc" body="Concentration or presentation strength of the precise active ingredient"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelMedication_batch" name="batch" visibility="public">
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_batch_lotNumber_attr" name="lotNumber" visibility="public" type="id_type_string">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_batch_lotNumber_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_batch_lotNumber_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_batch_lotNumber_attr_doc" body="Batch number"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedication_batch_expirationDate_attr" name="expirationDate" visibility="public" type="id_type_dateTime">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_batch_expirationDate_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_batch_expirationDate_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedication_batch_expirationDate_attr_doc" body="Expiry date"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="id_BeModelMedication_item_attr_assoc" memberEnd="id_BeModelMedication_item_attr id_BeModelMedication_item_attr_end">
        <ownedEnd xmi:type="uml:Property" xmi:id="id_BeModelMedication_item_attr_end" type="id_BeModelMedication" association="id_BeModelMedication_item_attr_assoc">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_item_attr_end_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_item_attr_end_up" value="1"/>
        </ownedEnd>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="id_BeModelMedication_batch_attr_assoc" memberEnd="id_BeModelMedication_batch_attr id_BeModelMedication_batch_attr_end">
        <ownedEnd xmi:type="uml:Property" xmi:id="id_BeModelMedication_batch_attr_end" type="id_BeModelMedication" association="id_BeModelMedication_batch_attr_assoc">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_batch_attr_end_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_batch_attr_end_up" value="1"/>
        </ownedEnd>
      </packagedElement>
      <packagedElement xmi:type="uml:Association" xmi:id="id_BeModelMedication_item_ingredient_attr_assoc" memberEnd="id_BeModelMedication_item_ingredient_attr id_BeModelMedication_item_ingredient_attr_end">
        <ownedEnd xmi:type="uml:Property" xmi:id="id_BeModelMedication_item_ingredient_attr_end" type="id_BeModelMedication_item" association="id_BeModelMedication_item_ingredient_attr_assoc">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedication_item_ingredient_attr_end_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedication_item_ingredient_attr_end_up" value="1"/>
        </ownedEnd>
      </packagedElement>
    </packagedElement>
    <packagedElement xmi:type="uml:Package" xmi:id="id_BeModelMedication_types" name="Data Types" visibility="public">
      <packagedElement xmi:type="uml:DataType" xmi:id="id_type_CodeableConcept" name="CodeableConcept" visibility="public"/>
      <packagedElement xmi:type="uml:DataType" xmi:id="id_type_Quantity" name="Quantity" visibility="public"/>
      <packagedElement xmi:type="uml:DataType" xmi:id="id_type_Ratio" name="Ratio" visibility="public"/>
      <packagedElement xmi:type="uml:DataType" xmi:id="id_type_string" name="string" visibility="public"/>
      <packagedElement xmi:type="uml:DataType" xmi:id="id_type_dateTime" name="dateTime" visibility="public"/>
    </packagedElement>
  </uml:Model>
  <xmi:Extension extender="Enterprise Architect" extenderID="6.5">
    <diagrams><diagram xmi:id="id_BeModelMedication_diagram">
      <model package="id_BeModelMedication_pkg" owner="id_BeModelMedication_pkg"/>

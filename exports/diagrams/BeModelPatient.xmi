  <xmi:Documentation exporter="generate_model_diagrams" exporterVersion="1.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="id_BeModelPatient_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_BeModelPatient_pkg" name="BeModelPatient" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelPatient" name="BeModelPatient" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_doc" body="Data about a patient, according to the [National Register of Persons (Ministry of the Interior)](https://www.ibz.rrn.fgov.be/fileadmin/user_upload/nl/rr/bestand-rr/bestand-RR.pdf), and possibly other sources to be mentioned when used."/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelPatient_names_attr" name="names" visibility="public" type="id_BeModelPatient_names" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelPatient_names_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelPatient_names_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_names_attr_doc" body="Names"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelPatient_birth_attr" name="birth" visibility="public" type="id_BeModelPatient_birth" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelPatient_birth_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelPatient_birth_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_birth_attr_doc" body="Birth data"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelPatient_gender_attr" name="gender" visibility="public" type="id_BeModelPatient_gender" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelPatient_gender_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelPatient_gender_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_gender_attr_doc" body="Gender"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelPatient_nationality_attr" name="nationality" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelPatient_nationality_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelPatient_nationality_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_nationality_attr_doc" body="Current nationality (and dual nationality) (NR 31, NR 32)"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelPatient_residence_attr" name="residence" visibility="public" type="id_type_Address">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelPatient_residence_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelPatient_residence_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_residence_attr_doc" body="Main and other residences (NR 1, 3, 5, 18, 19, 20,22, 23, 24, 26, 27). NR 252 will be covered by other privacy rules."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelPatient_death_attr" name="death" visibility="public" type="id_BeModelPatient_death" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelPatient_death_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelPatient_death_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_death_attr_doc" body="Date and state of death (place of death is not clinically relevant, and we only care about factual death, not absence (NR 151) or administrative/judicial death (NR 150))"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelPatient_maritalstatus_attr" name="maritalstatus" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelPatient_maritalstatus_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelPatient_maritalstatus_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_maritalstatus_attr_doc" body="Marital Status"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelPatient_names" name="names" visibility="public">
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelPatient_names_usage_attr" name="usage" visibility="public" type="id_type_CodeableConcept">

          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelPatient_names_title_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_names_title_attr_doc" body="Title of nobility (NR 12)"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelPatient_names_period_attr" name="period" visibility="public" type="id_type_Period">

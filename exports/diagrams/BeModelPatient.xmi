          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelPatient_names_period_attr_doc" body="Period of validity of the name (e.g. NR 13 Change of name, first names and title of nobility)"/>
        </ownedAttribute>
      </packagedElement>
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelPatient_birth" name="birth" visibility="public">

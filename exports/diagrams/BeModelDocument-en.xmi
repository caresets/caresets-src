          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelDocument_dateTime_attr_doc" body="Document date/time"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelDocument_title_attr" name="title" visibility="public" type="id_type_string">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelDocument_title_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelDocument_title_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelDocument_title_attr_doc" body="Title"/>

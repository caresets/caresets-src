      <elements>
        <element subject="id_BeModelDocument" geometry="Left=40;Top=40;Right=300;Bottom=240;"/>
        <element subject="id_BeModelDocument_section" geometry="Left=340;Top=40;Right=600;Bottom=240;"/>

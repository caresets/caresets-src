  <xmi:Documentation exporter="generate_model_diagrams" exporterVersion="1.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="id_BeModelDocument_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_BeModelDocument_pkg" name="BeModelDocument" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelDocument" name="BeModelDocument" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelDocument_doc" body="Generic logical model for a FHIR document structuring and containing caresets."/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelDocument_identifier_attr" name="identifier" visibility="public" type="id_type_Identifier">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelDocument_identifier_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelDocument_identifier_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelDocument_identifier_attr_doc" body="Document identifier"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelDocument_type_attr" name="type" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelDocument_type_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelDocument_type_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelDocument_type_attr_doc" body="Document type"/>

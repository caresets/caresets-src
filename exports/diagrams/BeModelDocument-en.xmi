          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelDocument_language_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelDocument_language_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelDocument_language_attr_doc" body="Language"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelDocument_subject_attr" name="subject" visibility="public" type="id_type_Reference">

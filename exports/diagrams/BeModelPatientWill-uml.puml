@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FEFECE
  BorderColor #000000
  ArrowColor #000000
  FontStyle bold
  AttributeFontStyle normal
}
hide circle
hide empty members

class "BeModelPatientWill" as BeModelPatientWill {
  +recordedDate : dateTime [1]
  +identifier : Identifier [0..1]
  +patient : Identifier [1]
  +recorder : Identifier [1]
  +source[x] : Binary | url [0..1]
  +category : CodeableConcept [1]
  +note : string [0..1]
}

class "BeModelPatientWill.representative" as BeModelPatientWill_representative {
  +role : CodeableConcept [0..1]
  +relationship : CodeableConcept [0..1]
}

class "BeModelPatientWill.willCode" as BeModelPatientWill_willCode {
  +status : CodeableConcept [0..1]
}

class "BeModelPatientWill.willCode.period" as BeModelPatientWill_willCode_period {
  +startperiod : dateTime [0..1]
  +endperiod : dateTime [0..1]
}

BeModelPatientWill *-- "0..*" BeModelPatientWill_representative : representative
BeModelPatientWill *-- "1..1" BeModelPatientWill_willCode : willCode
BeModelPatientWill_willCode *-- "0..1" BeModelPatientWill_willCode_period : period
@enduml
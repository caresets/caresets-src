class "period" as BeModelPatient_names_period <<Period>> {
}

class "birth" as BeModelPatient_birth <<BackboneElement>> {
}

class "address" as BeModelPatient_birth_address <<Address>> {
}

class "date" as BeModelPatient_birth_date <<dateTime>> {
}

class "gender" as BeModelPatient_gender <<BackboneElement>> {
}

class "administrative" as BeModelPatient_gender_administrative <<CodeableConcept>> {
}

class "atbirth" as BeModelPatient_gender_atbirth <<CodeableConcept>> {
}

class "social" as BeModelPatient_gender_social <<CodeableConcept>> {
}

class "nationality" as BeModelPatient_nationality <<CodeableConcept>> {
}

class "residence" as BeModelPatient_residence <<Address>> {
}

class "death" as BeModelPatient_death <<BackboneElement>> {
}

class "date" as BeModelPatient_death_date <<dateTime>> {
}

class "deceased" as BeModelPatient_death_deceased <<boolean>> {
}

class "maritalstatus" as BeModelPatient_maritalstatus <<CodeableConcept>> {
}

BeModelPatient *-- "0..*" BeModelPatient_names

@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam class {
  BackgroundColor #FEFECE
  BorderColor #000000
  ArrowColor #000000
  FontStyle bold
  AttributeFontStyle normal
}
hide circle
hide empty members

class "BeModelCareTeam" as BeModelCareTeam {
  +name : string [0..1]
  +identifier : Identifier [0..*]
  +category : CodeableConcept [0..*]
  +status : code [0..1]
  +subject : Reference [0..1]
  +period : Period [0..1]
  +managingOrganization : Reference [0..1]
  +contact : ContactPoint [0..*]
  +note : string [0..*]
}

class "BeModelCareTeam.participant" as BeModelCareTeam_participant {
  +role : CodeableConcept [0..1]
  +member : Reference [1]
  +period : Period [0..1]
}

BeModelCareTeam *-- "0..*" BeModelCareTeam_participant : participant
@enduml
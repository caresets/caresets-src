          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelDiagnosticReportDiabetes_Note_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelDiagnosticReportDiabetes_Note_attr_doc" body="Report comments in free text format. This element will not be provided by the producer of the report, but will be provided by the healthcare provider doing the interpretation."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelDiagnosticReportDiabetes_Document_attr" name="Document" visibility="public" type="id_type_Binary">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelDiagnosticReportDiabetes_Document_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelDiagnosticReportDiabetes_Document_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelDiagnosticReportDiabetes_Document_attr_doc" body="PDF document containing the complete report (text, graphics, deduced observations, conclusions, etc.)"/>
        </ownedAttribute>

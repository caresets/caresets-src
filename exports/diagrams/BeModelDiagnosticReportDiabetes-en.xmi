          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelDiagnosticReportDiabetes_Status_attr_doc" body="Report status. By default it is “Final”. Value according to the business rule on “% Data Captured” see VS_DiagRep_Status"/>
        </ownedAttribute>

  <uml:Model xmi:type="uml:Model" xmi:id="id_MedicationLine_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_MedicationLine_pkg" name="MedicationLine" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_MedicationLine" name="MedicationLine" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_MedicationLine_doc" body="Logical data model for medication line."/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_MedicationLine_identifier_attr" name="identifier" visibility="public" type="id_type_Identifier">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_MedicationLine_identifier_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_MedicationLine_identifier_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_MedicationLine_identifier_attr_doc" body="A unique identifier for the medication line. This identifier alone may be the same for different versions of the medication line."/>

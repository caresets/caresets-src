          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_dispensedItem_attr_doc" body="Each product that was dispensed"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_note_attr" name="note" visibility="public" type="id_type_Annotation">

  <xmi:Documentation exporter="generate_model_diagrams" exporterVersion="1.0"/>
  <uml:Model xmi:type="uml:Model" xmi:id="id_BeModelMedicationDispense_model" name="EA_Model" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="id_BeModelMedicationDispense_pkg" name="BeModelMedicationDispense" visibility="public">
      <packagedElement xmi:type="uml:Class" xmi:id="id_BeModelMedicationDispense" name="BeModelMedicationDispense" visibility="public">
        <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_doc" body="This is the logical model for the Dispense Record entry - the information that can be captured upon the act of dispensing - in a hospital pharmacy, or a community pharmacy. This is not for a future dispense, rather a record of an actual dispense."/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_identifier_attr" name="identifier" visibility="public" type="id_type_Identifier">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedicationDispense_identifier_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedicationDispense_identifier_attr_up" value="*"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_identifier_attr_doc" body="The business identifier(s) for the medication dispense session, also known as Session GUID (SGUID)."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_recordedDate_attr" name="recordedDate" visibility="public" type="id_type_dateTime">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedicationDispense_recordedDate_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedicationDispense_recordedDate_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_recordedDate_attr_doc" body="The date (or date+time) when the dispense was recorded"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_basedOnMedicationLine_attr" name="basedOnMedicationLine" visibility="public" type="id_type_Reference_BeModelMedicationLine_">

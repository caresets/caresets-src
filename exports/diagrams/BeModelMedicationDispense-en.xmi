          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedicationDispense_dispenseDate_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_dispenseDate_attr_doc" body="The date (or date+time) when the dispense ocurred"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_prescription_attr" name="prescription" visibility="public" type="id_BeModelMedicationDispense_prescription" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedicationDispense_prescription_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedicationDispense_prescription_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_prescription_attr_doc" body="Information about a prescription related to the dispense"/>

          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedicationDispense_basedOnMedicationLine_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_basedOnMedicationLine_attr_doc" body="The medication line that this dispense is related to"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_patient_attr" name="patient" visibility="public" type="id_type_Reference_be_patient_">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedicationDispense_patient_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedicationDispense_patient_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_patient_attr_doc" body="The person for which the medication is dispensed."/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_status_attr" name="status" visibility="public" type="id_type_code">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedicationDispense_status_attr_lo" value="1"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedicationDispense_status_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_status_attr_doc" body="The status of the dispense record [ValueSet: medicationdispense-status]"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_statusReason_attr" name="statusReason" visibility="public" type="id_type_CodeableConcept">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedicationDispense_statusReason_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedicationDispense_statusReason_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_statusReason_attr_doc" body="The reason why the dispense was not performed, if it was not performed [ValueSet: medicationdispense-status-reason]"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_dispenser_attr" name="dispenser" visibility="public" type="id_BeModelMedicationDispense_dispenser" aggregation="composite">
          <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_BeModelMedicationDispense_dispenser_attr_lo" value="0"/>
          <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_BeModelMedicationDispense_dispenser_attr_up" value="1"/>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_BeModelMedicationDispense_dispenser_attr_doc" body="The dispenser, if known and relevant"/>
        </ownedAttribute>
        <ownedAttribute xmi:type="uml:Property" xmi:id="id_BeModelMedicationDispense_dispenseDate_attr" name="dispenseDate" visibility="public" type="id_type_dateTime">
